[
 {
  "i": 0,
  "start": 0.16,
  "end": 1.92,
  "text": "Satu video lagi..."
 },
 {
  "i": 1,
  "start": 2.0,
  "end": 3.04,
  "text": "habis itu tidur."
 },
 {
  "i": 2,
  "start": 3.52,
  "end": 5.52,
  "text": "Kamu bilang itu jam 10."
 },
 {
  "i": 3,
  "start": 5.56,
  "end": 6.56,
  "text": "Sekarang..."
 },
 {
  "i": 4,
  "start": 6.64,
  "end": 7.44,
  "text": "jam 2 pagi."
 },
 {
  "i": 5,
  "start": 7.92,
  "end": 10.72,
  "text": "Kita sering dengar: tidur enam jam itu cukup."
 },
 {
  "i": 6,
  "start": 10.76,
  "end": 12.56,
  "text": "Lama-lama badan terbiasa."
 },
 {
  "i": 7,
  "start": 12.693,
  "end": 17.44,
  "text": "Tapi peneliti Universitas Pennsylvania, tahun 2003, mengujinya."
 },
 {
  "i": 8,
  "start": 17.52,
  "end": 19.92,
  "text": "Enam jam semalam, 14 hari."
 },
 {
  "i": 9,
  "start": 19.96,
  "end": 25.2,
  "text": "Kemampuan berpikir mereka terus turun, hingga setara dua malam penuh tanpa tidur."
 },
 {
  "i": 10,
  "start": 25.28,
  "end": 26.24,
  "text": "Yang paling seram?"
 },
 {
  "i": 11,
  "start": 26.293,
  "end": 27.36,
  "text": "Mereka sendiri..."
 },
 {
  "i": 12,
  "start": 27.4,
  "end": 29.04,
  "text": "hampir tidak sadar."
 },
 {
  "i": 13,
  "start": 29.12,
  "end": 30.4,
  "text": "Kenapa tetap begadang?"
 },
 {
  "i": 14,
  "start": 30.44,
  "end": 32.64,
  "text": "Seringnya, bukan karena malas."
 },
 {
  "i": 15,
  "start": 32.72,
  "end": 36.48,
  "text": "Seharian, waktumu milik bos, dosen, orang lain."
 },
 {
  "i": 16,
  "start": 36.62,
  "end": 38.72,
  "text": "Ini satu-satunya waktu punyaku."
 },
 {
  "i": 17,
  "start": 38.8,
  "end": 41.2,
  "text": "Jadi kamu curi dari tidurmu sendiri."
 },
 {
  "i": 18,
  "start": 41.28,
  "end": 43.92,
  "text": "Dan besok, harimu makin bukan milikmu."
 },
 {
  "i": 19,
  "start": 44.0,
  "end": 44.96,
  "text": "Coba besok sore."
 },
 {
  "i": 20,
  "start": 45.0,
  "end": 45.92,
  "text": "15 menit."
 },
 {
  "i": 21,
  "start": 46.0,
  "end": 47.12,
  "text": "HP mati."
 },
 {
  "i": 22,
  "start": 47.2,
  "end": 48.64,
  "text": "Waktu itu punyamu."
 },
 {
  "i": 23,
  "start": 48.68,
  "end": 51.12,
  "text": "Malamnya, kamu tidak perlu balas dendam."
 },
 {
  "i": 24,
  "start": 51.248,
  "end": 53.84,
  "text": "Begadang bukan soal malam yang kurang disiplin."
 },
 {
  "i": 25,
  "start": 53.92,
  "end": 55.68,
  "text": "Tapi siang yang bukan milikmu."
 },
 {
  "i": 26,
  "start": 55.72,
  "end": 56.56,
  "text": "Kalau tidak..."
 },
 {
  "i": 27,
  "start": 56.6,
  "end": 58.4,
  "text": "nanti malam kamu bilang lagi:"
 }
]