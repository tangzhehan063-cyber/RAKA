[
 {
  "i": 0,
  "start": 0.16,
  "end": 1.68,
  "text": "Gitar itu..."
 },
 {
  "i": 1,
  "start": 1.76,
  "end": 3.68,
  "text": "12 tahun di atas lemari."
 },
 {
  "i": 2,
  "start": 4.32,
  "end": 8.64,
  "text": "Jam satu pagi, Dimas, 31 tahun, menatapnya lagi."
 },
 {
  "i": 3,
  "start": 9.2,
  "end": 13.6,
  "text": "Kita sering dengar: penyesalan terbesar adalah kesalahan yang kita buat."
 },
 {
  "i": 4,
  "start": 13.733,
  "end": 20.88,
  "text": "Tapi peneliti Cornell University, tahun 2018, menanyakan penyesalan terbesar dalam hidup ratusan orang."
 },
 {
  "i": 5,
  "start": 20.96,
  "end": 22.24,
  "text": "76 persen..."
 },
 {
  "i": 6,
  "start": 22.32,
  "end": 23.76,
  "text": "menjawab hal yang mirip."
 },
 {
  "i": 7,
  "start": 23.84,
  "end": 25.12,
  "text": "Bukan salah langkah."
 },
 {
  "i": 8,
  "start": 25.2,
  "end": 27.76,
  "text": "Tapi diri yang tidak pernah mereka kejar."
 },
 {
  "i": 9,
  "start": 27.8,
  "end": 28.72,
  "text": "Kenapa awet?"
 },
 {
  "i": 10,
  "start": 28.76,
  "end": 32.16,
  "text": "Karena kewajiban yang gagal biasanya cepat kita tebus."
 },
 {
  "i": 11,
  "start": 32.2,
  "end": 33.28,
  "text": "Mimpi..."
 },
 {
  "i": 12,
  "start": 33.32,
  "end": 34.08,
  "text": "kita tunda."
 },
 {
  "i": 13,
  "start": 34.427,
  "end": 35.2,
  "text": "Udah telat."
 },
 {
  "i": 14,
  "start": 35.44,
  "end": 36.16,
  "text": "Udah tua."
 },
 {
  "i": 15,
  "start": 36.56,
  "end": 37.12,
  "text": "Malu."
 },
 {
  "i": 16,
  "start": 37.568,
  "end": 40.4,
  "text": "Dan penyesalan itu tidak pernah selesai."
 },
 {
  "i": 17,
  "start": 40.44,
  "end": 43.2,
  "text": "Malam itu, Dimas menurunkan gitarnya."
 },
 {
  "i": 18,
  "start": 43.28,
  "end": 44.48,
  "text": "Senarnya fals."
 },
 {
  "i": 19,
  "start": 44.56,
  "end": 45.52,
  "text": "Jarinya kaku."
 },
 {
  "i": 20,
  "start": 45.68,
  "end": 46.72,
  "text": "Cuma lima menit."
 },
 {
  "i": 21,
  "start": 46.853,
  "end": 48.64,
  "text": "Tapi untuk pertama kalinya..."
 },
 {
  "i": 22,
  "start": 48.68,
  "end": 50.48,
  "text": "penyesalan itu bergerak."
 },
 {
  "i": 23,
  "start": 50.622,
  "end": 52.48,
  "text": "Penyesalan bukan soal masa lalu."
 },
 {
  "i": 24,
  "start": 52.56,
  "end": 54.72,
  "text": "Tapi arah yang belum kamu ambil."
 },
 {
  "i": 25,
  "start": 54.8,
  "end": 57.76,
  "text": "Karena yang paling kamu sesali, mungkin cuma..."
 }
]