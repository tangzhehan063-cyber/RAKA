[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.0,
  "text": "52 hari lagi..."
 },
 {
  "i": 1,
  "start": 2.16,
  "end": 3.0,
  "text": "tahun baru."
 },
 {
  "i": 2,
  "start": 3.2,
  "end": 6.48,
  "text": "Dan kamu sudah punya rencana: mulai tanggal satu."
 },
 {
  "i": 3,
  "start": 6.8,
  "end": 7.76,
  "text": "Mulai olahraga."
 },
 {
  "i": 4,
  "start": 8.0,
  "end": 9.04,
  "text": "Mulai nabung."
 },
 {
  "i": 5,
  "start": 9.12,
  "end": 10.32,
  "text": "Mulai jadi orang baru."
 },
 {
  "i": 6,
  "start": 10.64,
  "end": 11.68,
  "text": "Tapi..."
 },
 {
  "i": 7,
  "start": 11.72,
  "end": 12.32,
  "text": "nanti."
 },
 {
  "i": 8,
  "start": 12.64,
  "end": 13.44,
  "text": "Bukan sekarang."
 },
 {
  "i": 9,
  "start": 13.84,
  "end": 15.68,
  "text": "Ternyata kamu tidak sendirian."
 },
 {
  "i": 10,
  "start": 15.92,
  "end": 21.2,
  "text": "Peneliti Wharton menemukan: setelah tahun baru, pencarian kata diet melonjak."
 },
 {
  "i": 11,
  "start": 21.52,
  "end": 23.04,
  "text": "Orang lebih rajin ke gym..."
 },
 {
  "i": 12,
  "start": 23.08,
  "end": 26.28,
  "text": "tiap awal minggu, awal bulan, awal semester."
 },
 {
  "i": 13,
  "start": 26.48,
  "end": 29.2,
  "text": "Tanggal baru terasa seperti halaman kosong."
 },
 {
  "i": 14,
  "start": 29.28,
  "end": 30.4,
  "text": "Diri yang lama..."
 },
 {
  "i": 15,
  "start": 30.48,
  "end": 32.4,
  "text": "seolah tertinggal di halaman sebelumnya."
 },
 {
  "i": 16,
  "start": 32.72,
  "end": 34.4,
  "text": "Tapi ada sisi gelapnya."
 },
 {
  "i": 17,
  "start": 34.64,
  "end": 38.4,
  "text": "Penelitian lanjutan menemukan: saat kita menunggu tanggal baru..."
 },
 {
  "i": 18,
  "start": 38.56,
  "end": 40.72,
  "text": "usaha kita hari ini justru turun."
 },
 {
  "i": 19,
  "start": 41.097,
  "end": 42.96,
  "text": "Toh sebentar lagi mulai dari nol."
 },
 {
  "i": 20,
  "start": 43.36,
  "end": 45.2,
  "text": "Jadi 52 hari ini..."
 },
 {
  "i": 21,
  "start": 45.28,
  "end": 46.16,
  "text": "kamu buang."
 },
 {
  "i": 22,
  "start": 46.24,
  "end": 47.04,
  "text": "Dengan sadar."
 },
 {
  "i": 23,
  "start": 47.28,
  "end": 50.96,
  "text": "Padahal halaman kosong itu tidak harus menunggu kalender."
 },
 {
  "i": 24,
  "start": 51.04,
  "end": 52.44,
  "text": "Senin juga halaman baru."
 },
 {
  "i": 25,
  "start": 52.56,
  "end": 53.68,
  "text": "Besok pagi juga."
 },
 {
  "i": 26,
  "start": 53.72,
  "end": 54.48,
  "text": "Bahkan..."
 },
 {
  "i": 27,
  "start": 54.56,
  "end": 55.44,
  "text": "malam ini."
 },
 {
  "i": 28,
  "start": 55.52,
  "end": 56.4,
  "text": "Ambil spidol."
 },
 {
  "i": 29,
  "start": 56.48,
  "end": 57.6,
  "text": "Lingkari hari ini."
 },
 {
  "i": 30,
  "start": 57.76,
  "end": 59.52,
  "text": "Tulis: hari satu."
 },
 {
  "i": 31,
  "start": 59.712,
  "end": 61.44,
  "text": "Tahun baru tidak mengubah orang."
 },
 {
  "i": 32,
  "start": 61.56,
  "end": 63.28,
  "text": "Orang yang memutuskan mulai..."
 },
 {
  "i": 33,
  "start": 63.36,
  "end": 64.8,
  "text": "yang mengubah tahunnya."
 },
 {
  "i": 34,
  "start": 64.84,
  "end": 67.28,
  "text": "Kalau tidak, tahun depan kamu bilang lagi:"
 }
]