[
 {
  "i": 0,
  "start": 0.16,
  "end": 1.28,
  "text": "Jam tiga pagi."
 },
 {
  "i": 1,
  "start": 1.84,
  "end": 3.36,
  "text": "Nara masih melek..."
 },
 {
  "i": 2,
  "start": 3.44,
  "end": 4.64,
  "text": "menatap langit-langit."
 },
 {
  "i": 3,
  "start": 5.22,
  "end": 7.2,
  "text": "Besok presentasimu bakal kacau."
 },
 {
  "i": 4,
  "start": 7.728,
  "end": 9.04,
  "text": "Dan dia percaya."
 },
 {
  "i": 5,
  "start": 9.28,
  "end": 13.48,
  "text": "Kita sering mengira: kalau kita khawatir, berarti bahayanya nyata."
 },
 {
  "i": 6,
  "start": 13.68,
  "end": 20.4,
  "text": "Tapi peneliti Penn State meminta 29 orang dengan gangguan kecemasan mencatat setiap kekhawatirannya..."
 },
 {
  "i": 7,
  "start": 20.453,
  "end": 23.04,
  "text": "lalu mengecek mana yang benar-benar terjadi."
 },
 {
  "i": 8,
  "start": 23.36,
  "end": 24.16,
  "text": "Hasilnya?"
 },
 {
  "i": 9,
  "start": 24.2,
  "end": 25.84,
  "text": "91 persen..."
 },
 {
  "i": 10,
  "start": 25.96,
  "end": 27.28,
  "text": "tidak pernah terjadi."
 },
 {
  "i": 11,
  "start": 27.44,
  "end": 28.8,
  "text": "Dan bagi banyak peserta..."
 },
 {
  "i": 12,
  "start": 28.92,
  "end": 30.88,
  "text": "tidak ada satu pun yang jadi kenyataan."
 },
 {
  "i": 13,
  "start": 31.2,
  "end": 35.92,
  "text": "Tapi setiap malam, suara itu kembali, dengan ramalan yang sama."
 },
 {
  "i": 14,
  "start": 36.4,
  "end": 38.8,
  "text": "Malam itu, Nara menyalakan lampu."
 },
 {
  "i": 15,
  "start": 38.88,
  "end": 40.88,
  "text": "Menulis satu ketakutannya di kertas."
 },
 {
  "i": 16,
  "start": 41.04,
  "end": 42.0,
  "text": "Lalu tidur."
 },
 {
  "i": 17,
  "start": 42.08,
  "end": 43.28,
  "text": "Seminggu kemudian..."
 },
 {
  "i": 18,
  "start": 43.36,
  "end": 44.16,
  "text": "ia mencoretnya."
 },
 {
  "i": 19,
  "start": 44.84,
  "end": 46.88,
  "text": "Overthinking bukan soal kamu lemah."
 },
 {
  "i": 20,
  "start": 46.92,
  "end": 49.36,
  "text": "Tapi otakmu terlalu sayang sama kamu."
 },
 {
  "i": 21,
  "start": 49.4,
  "end": 52.0,
  "text": "Jadi malam ini, tulis satu ketakutanmu."
 },
 {
  "i": 22,
  "start": 52.08,
  "end": 53.92,
  "text": "Karena sebagian besar ketakutan..."
 },
 {
  "i": 23,
  "start": 54.0,
  "end": 55.84,
  "text": "cuma lahir di jam tiga pagi."
 }
]