[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.16,
  "speechEnd": 2.72,
  "text": "Hari ke-9. Hujan.",
  "end": 2.89
 },
 {
  "i": 1,
  "start": 2.89,
  "speechStart": 3.04,
  "speechEnd": 4.32,
  "text": "Raka menyerah...",
  "end": 4.49
 },
 {
  "i": 2,
  "start": 4.49,
  "speechStart": 4.64,
  "speechEnd": 9.0,
  "text": "Dan justru di sinilah, kebiasaan dibentuk. Kita sering dengar:",
  "end": 9.05
 },
 {
  "i": 3,
  "start": 9.05,
  "speechStart": 9.2,
  "speechEnd": 11.96,
  "text": "21 hari untuk membentuk kebiasaan.",
  "end": 12.01
 },
 {
  "i": 4,
  "start": 12.01,
  "speechStart": 12.16,
  "speechEnd": 17.4,
  "text": "Tapi studi University College London, tahun 2009, menemukan angka tengahnya...",
  "end": 17.37
 },
 {
  "i": 5,
  "start": 17.37,
  "speechStart": 17.52,
  "speechEnd": 19.04,
  "text": "66 hari.",
  "end": 18.97
 },
 {
  "i": 6,
  "start": 18.97,
  "speechStart": 19.12,
  "speechEnd": 20.6,
  "text": "Ada yang 18 hari...",
  "end": 20.49
 },
 {
  "i": 7,
  "start": 20.49,
  "speechStart": 20.64,
  "speechEnd": 23.84,
  "text": "ada yang diperkirakan sampai 254.",
  "end": 23.77
 },
 {
  "i": 8,
  "start": 23.77,
  "speechStart": 23.92,
  "speechEnd": 25.64,
  "text": "Dan ini bagian terpentingnya.",
  "end": 25.53
 },
 {
  "i": 9,
  "start": 25.53,
  "speechStart": 25.68,
  "speechEnd": 27.333,
  "text": "Melewatkan satu hari...",
  "end": 27.237
 },
 {
  "i": 10,
  "start": 27.237,
  "speechStart": 27.387,
  "speechEnd": 29.0,
  "text": "tidak berpengaruh berarti.",
  "end": 28.89
 },
 {
  "i": 11,
  "start": 28.89,
  "speechStart": 29.04,
  "speechEnd": 31.947,
  "text": "Yang membunuh kebiasaan bukan gagal sekali.",
  "end": 31.823
 },
 {
  "i": 12,
  "start": 31.823,
  "speechStart": 31.973,
  "speechEnd": 34.88,
  "text": "Tapi cerita, aku memang nggak disiplin...",
  "end": 34.797
 },
 {
  "i": 13,
  "start": 34.797,
  "speechStart": 34.947,
  "speechEnd": 36.56,
  "text": "lalu berhenti total.",
  "end": 36.45
 },
 {
  "i": 14,
  "start": 36.45,
  "speechStart": 36.6,
  "speechEnd": 40.72,
  "text": "Hari ke-10, Raka kembali. Pelan. Tanpa semangat.",
  "end": 40.623
 },
 {
  "i": 15,
  "start": 40.623,
  "speechStart": 40.773,
  "speechEnd": 44.4,
  "text": "Hari ke-66, ia berlari... tanpa berpikir.",
  "end": 44.463
 },
 {
  "i": 16,
  "start": 44.463,
  "speechStart": 44.613,
  "speechEnd": 46.8,
  "text": "Disiplin bukan soal tidak pernah jatuh.",
  "end": 46.69
 },
 {
  "i": 17,
  "start": 46.69,
  "speechStart": 46.84,
  "speechEnd": 49.2,
  "text": "Tapi seberapa cepat kamu kembali.",
  "end": 49.09
 },
 {
  "i": 18,
  "start": 49.09,
  "speechStart": 49.24,
  "speechEnd": 51.04,
  "text": "Karena hari ke-9 itu...",
  "end": 52.54
 }
]