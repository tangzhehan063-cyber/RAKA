[
 {
  "i": 0,
  "start": 0.16,
  "end": 1.44,
  "text": "Hari ke-9."
 },
 {
  "i": 1,
  "start": 1.76,
  "end": 2.72,
  "text": "Hujan."
 },
 {
  "i": 2,
  "start": 3.04,
  "end": 4.32,
  "text": "Raka menyerah..."
 },
 {
  "i": 3,
  "start": 4.64,
  "end": 7.8,
  "text": "Dan justru di sinilah, kebiasaan dibentuk."
 },
 {
  "i": 4,
  "start": 8.0,
  "end": 11.96,
  "text": "Kita sering dengar: 21 hari untuk membentuk kebiasaan."
 },
 {
  "i": 5,
  "start": 12.16,
  "end": 17.4,
  "text": "Tapi studi University College London, tahun 2009, menemukan angka tengahnya..."
 },
 {
  "i": 6,
  "start": 17.52,
  "end": 19.04,
  "text": "66 hari."
 },
 {
  "i": 7,
  "start": 19.12,
  "end": 20.6,
  "text": "Ada yang 18 hari..."
 },
 {
  "i": 8,
  "start": 20.64,
  "end": 23.84,
  "text": "ada yang diperkirakan sampai 254."
 },
 {
  "i": 9,
  "start": 23.92,
  "end": 25.64,
  "text": "Dan ini bagian terpentingnya."
 },
 {
  "i": 10,
  "start": 25.68,
  "end": 27.333,
  "text": "Melewatkan satu hari..."
 },
 {
  "i": 11,
  "start": 27.387,
  "end": 29.0,
  "text": "tidak berpengaruh berarti."
 },
 {
  "i": 12,
  "start": 29.04,
  "end": 31.947,
  "text": "Yang membunuh kebiasaan bukan gagal sekali."
 },
 {
  "i": 13,
  "start": 31.973,
  "end": 34.88,
  "text": "Tapi cerita, aku memang nggak disiplin..."
 },
 {
  "i": 14,
  "start": 34.947,
  "end": 36.56,
  "text": "lalu berhenti total."
 },
 {
  "i": 15,
  "start": 36.6,
  "end": 38.8,
  "text": "Hari ke-10, Raka kembali."
 },
 {
  "i": 16,
  "start": 38.96,
  "end": 39.6,
  "text": "Pelan."
 },
 {
  "i": 17,
  "start": 39.68,
  "end": 40.72,
  "text": "Tanpa semangat."
 },
 {
  "i": 18,
  "start": 40.773,
  "end": 43.2,
  "text": "Hari ke-66, ia berlari..."
 },
 {
  "i": 19,
  "start": 43.32,
  "end": 44.4,
  "text": "tanpa berpikir."
 },
 {
  "i": 20,
  "start": 44.613,
  "end": 46.8,
  "text": "Disiplin bukan soal tidak pernah jatuh."
 },
 {
  "i": 21,
  "start": 46.84,
  "end": 49.2,
  "text": "Tapi seberapa cepat kamu kembali."
 },
 {
  "i": 22,
  "start": 49.24,
  "end": 51.04,
  "text": "Karena hari ke-9 itu..."
 }
]